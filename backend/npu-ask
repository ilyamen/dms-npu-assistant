#!/usr/bin/env python3
"""CLI for the npu-assistant API.  npu-ask [-c] [-s SESSION] QUESTION | npu-ask status | npu-ask history [ID]"""
import json
import sys
import urllib.request

URL = "http://127.0.0.1:8737"


def call(method, path, body=None):
    req = urllib.request.Request(URL + path, method=method, data=json.dumps(body).encode() if body else None,
                                 headers={"Content-Type": "application/json"})
    return urllib.request.urlopen(req, timeout=600)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return
    if argv[0] in ("status", "history"):
        path = "/status" if argv[0] == "status" else "/history" + ("/" + argv[1] if len(argv) > 1 else "")
        print(json.dumps(json.load(call("GET", path)), ensure_ascii=False, indent=1))
        return
    device, session = "npu", None
    while argv and argv[0].startswith("-"):
        flag = argv.pop(0)
        if flag == "-c":
            device = "cpu"
        elif flag == "-s":
            session = argv.pop(0)
    event = None
    for raw in call("POST", "/chat", {"message": " ".join(argv), "device": device, "session": session}):
        line = raw.decode().rstrip("\n")
        if line.startswith("event: "):
            event = line[7:]
        elif line.startswith("data: "):
            d = json.loads(line[6:])
            if event == "token":
                print(d["t"], end="", flush=True)
            elif event == "done":
                print(f"\n[{d['device']}: {d['tokens']} tok, {d['tps']} tok/s, ttft {d['ttft']}s]", file=sys.stderr)
            elif event == "error":
                print(f"ошибка ({d['code']}): {d['message']}", file=sys.stderr)
                sys.exit(1)
            else:
                print(f"[{event}: {d}]", file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv[1:])
